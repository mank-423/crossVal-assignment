# Copy to .env only when the API is not reachable through the dev proxy.
#
# Development: leave this unset. vite.config.ts proxies /api to http://localhost:3000, so the
# client uses the relative path and there is no CORS involved.
#
# Deployed: point it at the API, including the /api/v1 prefix, and set CORS_ORIGIN on the API
# to this site's origin.
# VITE_API_URL=https://your-api-host.example.com/api/v1

VITE_API_URL=http://localhost:3000
