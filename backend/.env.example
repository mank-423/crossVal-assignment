# Copy to .env and adjust. Never commit the real .env.

# Postgres connection string. A hosted provider's URL (Neon, Supabase, Render) drops in here
# unchanged; add ?sslmode=require when the provider needs TLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders_settlements

# Separate database used by the e2e suite. It is truncated between tests, so it must never
# point at the development database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders_settlements_test

# Signing secret for access tokens. Generate a real one for any deployed environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-before-deploying
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Origin allowed to call the API from a browser. The Vite dev server runs on 5173.
CORS_ORIGIN=http://localhost:5173
